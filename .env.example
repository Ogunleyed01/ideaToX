# ==============================================================================
# IdeaToX Environment Variables Template
# Copy this file to .env.local and populate the secrets as needed.
# Note: The platform ships with pre-seeded idea data and deterministic synthesizers,
# allowing full local exploration even before connecting live Supabase/AI services.
# ==============================================================================

# Supabase Public & Service Keys (Required for live auth and persistent PostgreSQL database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Gemini API Key (Optional: Powers live AI Spec Helper auto-expansion)
# If omitted, IdeaToX gracefully falls back to its built-in deterministic synthesizer.
GEMINI_API_KEY=your_gemini_api_key_here

# Application Base URL (Used for absolute OpenGraph links and OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
